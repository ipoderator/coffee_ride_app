{
  "name": "db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "seed:demo": "tsx src/seed-demo.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "5.0.3",
    "config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

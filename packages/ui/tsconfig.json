{
  "$schema": "https://json.schemastore.org/tsconfig",
  // No "build" script/dist output on purpose: unlike the Node-consumed
  // packages (types, maps-core, maps-2gis), packages/ui is meant to be
  // consumed as raw TSX source by apps/web's own bundler (Next's
  // `transpilePackages`) — the standard pattern for a shared React package in
  // a Next.js monorepo, avoiding a second build step that would just be
  // recompiled again by webpack/Turbopack anyway. Real components exist now
  // (CR-065), but `transpilePackages: ['ui']` still isn't wired into
  // apps/web's next.config — nothing there imports one yet, that starts with
  // CR-011's first real screen (same "wire it when there's a real consumer"
  // discipline CR-005/CR-006 used for the still-unconnected Redis/S3 clients).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },
  // vitest.setup.ts (root, not under src/) is included too — it's what pulls in
  // @testing-library/jest-dom/vitest's ambient module augmentation
  // (`toBeInTheDocument`, etc. on Vitest's `Assertion`); without it in the
  // program, `tsc --noEmit` doesn't see those matchers on `expect(...)` in the
  // component tests under src/, even though vitest itself runs them fine.
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist"]
}

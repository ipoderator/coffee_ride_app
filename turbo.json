{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_*",
        "AUTH_SECRET",
        "MAPS_2GIS_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_*",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_*",
        "AUTH_SECRET",
        "MAPS_2GIS_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": [
        "NEXT_PUBLIC_*",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_*",
        "AUTH_SECRET",
        "MAPS_2GIS_API_KEY"
      ]
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "NEXT_PUBLIC_*",
        "API_PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "S3_*",
        "AUTH_SECRET",
        "MAPS_2GIS_API_KEY"
      ]
    }
  }
}

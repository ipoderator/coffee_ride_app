# CR-218 (ADR-031). Production settings for a single host running
# docker-compose.prod.yml + docker-compose.infra.yml. Copy to `.env` in the
# repository root on the server (`cp deploy/production.env.example .env`), fill in,
# then run `deploy/deploy.sh`. Never commit the filled-in file (`.env` is ignored).
#
# Secrets: generate each with `openssl rand -hex 32`. Hex on purpose — the
# passwords go into connection URLs unescaped.

# --- Public address -----------------------------------------------------------
# The hostname whose DNS A/AAAA record points at this server. Caddy obtains its
# TLS certificate for it on first start; the API's CSRF origin is
# https://${DOMAIN} (derived in docker-compose.prod.yml, never set separately).
DOMAIN=
# Let's Encrypt expiry notices.
ACME_EMAIL=

# --- Application secret -------------------------------------------------------
# Required. The API refuses to start with the placeholder `change-me`.
AUTH_SECRET=

# --- Data services (docker-compose.infra.yml) ---------------------------------
# DATABASE_URL, REDIS_URL and S3_ENDPOINT are derived from these by the overlay —
# leave the three URL lines below empty.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Credentials of the self-hosted S3 (SeaweedFS). Any random values; the API and
# the storage both read them from here.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=coffee-ride
S3_REGION=us-east-1
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=

# --- Email (Unisender Go) -----------------------------------------------------
# Without both values, email verification and password reset never arrive:
# publishing a ride requires a verified email. EMAIL_FROM_ADDRESS must be a
# sender verified in the Unisender Go account.
UNISENDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Coffee Ride
# Empty = the default endpoint (https://go1.unisender.ru/ru/transactional/api/v1/).
UNISENDER_API_URL=
# Test deploys only: `true` creates new accounts already verified (no email
# needed to publish a ride). The API logs a preflight warning while it is on.
AUTH_SKIP_EMAIL_VERIFICATION=

# --- Maintenance (CR-265) -----------------------------------------------------
# `true` puts the site into planned maintenance: every page answers 503 with the
# «Технический пит-стоп» screen and `Retry-After`, the API answers 503
# `maintenance` (GET /health and the Google/Yandex/Strava callbacks stay up).
# Applied by recreating the two containers, no rebuild:
#   docker compose ... up -d --no-build web api   (deploy/FIRST-DEPLOY.md)
MAINTENANCE_MODE=
# Seconds for `Retry-After` (1..86400); empty = 600.
MAINTENANCE_RETRY_AFTER_SECONDS=

# --- Maps (2GIS) --------------------------------------------------------------
# Two separate keys (.claude/rules/maps.md). The MapGL key is public — baked into
# the web image at build time, so changing it needs a rebuild (deploy.sh does
# one). The API key stays on the server. Empty = maps show their placeholder and
# route building is unavailable. A demo key refuses routes over 50 km (KI-075).
NEXT_PUBLIC_MAPS_2GIS_MAPGL_KEY=
MAPS_2GIS_API_KEY=

# --- Strava (ADR-033) ---------------------------------------------------------
# Optional: «Синхронизировать со Strava» on the finish check-in. Both from
# strava.com/settings/api; set the app's Authorization Callback Domain to
# DOMAIN. Empty = the button is not shown.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Google sign-in (ADR-034) -------------------------------------------------
# Optional: «Войти через Google». OAuth client (type "Web application") from the
# Google Cloud Console; Authorized redirect URI must be exactly
# https://DOMAIN/api/v1/auth/google/callback. The consent screen needs the
# /privacy and /terms pages of this site. Empty = the button is not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- reCAPTCHA (ADR-038) ------------------------------------------------------
# «Я не робот» on register, password login and forgot-password. One reCAPTCHA v2
# "I'm not a robot" key pair for DOMAIN (google.com/recaptcha/admin). Set both or
# neither — the site key is baked into the web image at build time, so changing it
# needs a rebuild (deploy/deploy.sh builds). Empty = no CAPTCHA (the API preflight
# warns).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Yandex ID sign-in (ADR-037) ----------------------------------------------
# Optional: «Войти через Яндекс». App at oauth.yandex.ru (platform «Веб-сервисы»,
# rights login:info + login:email); Redirect URI must be exactly
# https://DOMAIN/api/v1/auth/yandex/callback. Empty = the button is not shown.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Operations ---------------------------------------------------------------
# Optional webhook for unexpected errors (ADR-030). Empty = errors only in the
# container logs (`docker compose logs api`), which rotate at 5 x 10 MB.
ERROR_REPORTING_WEBHOOK_URL=
# Database dumps into the `postgres_backups` volume: every 24 h, kept 14 days.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# CR-075, ADR-018. Mounted read-only into the `caddy` service in
# `docker-compose.prod.yml`. `{$VAR}` is Caddy's own env-var substitution —
# populated from the real host `.env` at container start, not templated by
# any script.
#
# Only one upstream: `web` (Next.js, apps/web/Dockerfile's runtime port).
# `/api/v1/*` is NOT routed here — apps/web/next.config.ts's own rewrite
# already forwards it to `apps/api` internally (ADR-018 §2). Routing it a
# second time here would duplicate that logic in two places.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	reverse_proxy web:3000
}

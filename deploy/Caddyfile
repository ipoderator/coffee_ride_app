# CR-075/271, ADR-018/043. Mounted read-only into the `caddy` service in
# `docker-compose.prod.yml`. `{$VAR}` is Caddy's own env-var substitution —
# populated from the real host `.env` at container start, not templated by
# any script.
#
# Coffee Ride has one upstream: `web` (Next.js, apps/web/Dockerfile's runtime port).
# `/api/v1/*` is NOT routed here — apps/web/next.config.ts's own rewrite
# already forwards it to `apps/api` internally (ADR-018 §2). Routing it a
# second time here would duplicate that logic in two places.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	reverse_proxy web:3000

	# CR-265: `web` not answering at all (a restart — e.g. switching
	# MAINTENANCE_MODE —, a deploy, a crash) gets the static maintenance page
	# instead of Caddy's empty 502: `deploy/maintenance/` is mounted read-only
	# and depends on nothing behind this proxy. A 503 that `web` itself sends
	# (planned maintenance) is an ordinary response and passes through as is.
	handle_errors 502 503 504 {
		header Retry-After 60
		header Cache-Control no-store
		header X-Robots-Tag noindex
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}

# CR-219: `www.` is a permanent redirect to the bare domain, so one canonical
# origin matches the API's CSRF check (https://${DOMAIN}). Needs its own DNS
# record; without one Caddy only logs a failed ACME attempt for it.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Блок для Caddy, который держит 80/443 на сервере (Caddyfile проекта coffee-ride).
# Домен всечеки.site в punycode. Контейнер vsecheki-web должен быть в той же сети Docker.
xn--b1agamj3b4b.site {
	encode gzip
	reverse_proxy vsecheki-web:80
}

www.xn--b1agamj3b4b.site {
	redir https://xn--b1agamj3b4b.site{uri} permanent
}

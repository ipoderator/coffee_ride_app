# CR-134. Interpolation values for docker-compose.prod.yml during the Docker
# smoke test (deploy/smoke/run.sh). Passed via --env-file so Compose never
# reads the developer's real root .env. AUTH_SECRET/WEB_ORIGIN are overridden
# literally in docker-compose.smoke.yml; the passwords below are throwaway values
# for docker-compose.infra.yml's services (CR-218), which live only as long as the
# run (`down -v`). The rest only keep `${VAR}` interpolation defined.
DOMAIN=smoke.invalid
ACME_EMAIL=
NEXT_PUBLIC_MAPS_2GIS_MAPGL_KEY=
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=smoke-s3-key
S3_SECRET_ACCESS_KEY=smoke-s3-secret
S3_BUCKET=coffee-ride-smoke
POSTGRES_PASSWORD=smoke-postgres
REDIS_PASSWORD=smoke-redis
AUTH_SECRET=
MAPS_2GIS_API_KEY=
ERROR_REPORTING_WEBHOOK_URL=
UNISENDER_API_KEY=
UNISENDER_API_URL=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# CR-134. Interpolation values for docker-compose.prod.yml during the Docker
# smoke test (deploy/smoke/run.sh). Passed via --env-file so Compose never
# reads the developer's real root .env. Every secret-bearing variable the api
# actually receives is overridden literally in docker-compose.smoke.yml; these
# only keep `${VAR}` interpolation defined (no "variable is not set" noise).
DOMAIN=smoke.invalid
ACME_EMAIL=
NEXT_PUBLIC_MAPS_2GIS_MAPGL_KEY=
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
AUTH_SECRET=
MAPS_2GIS_API_KEY=
ERROR_REPORTING_WEBHOOK_URL=

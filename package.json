{
  "name": "coffee-ride",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:root": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "smoke:docker": "bash deploy/smoke/run.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter web exec eslint --fix --no-warn-ignored"
    ],
    "apps/api/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter api exec eslint --fix --no-warn-ignored"
    ],
    "packages/config/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter config exec eslint --fix --no-warn-ignored"
    ],
    "packages/types/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter types exec eslint --fix --no-warn-ignored"
    ],
    "packages/ui/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter ui exec eslint --fix --no-warn-ignored"
    ],
    "packages/maps-core/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter maps-core exec eslint --fix --no-warn-ignored"
    ],
    "packages/maps-2gis/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter maps-2gis exec eslint --fix --no-warn-ignored"
    ],
    "packages/db/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter db exec eslint --fix --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript": "6.0.3"
  }
}

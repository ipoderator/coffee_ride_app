NODE_ENV=development

# apps/api listen port (CR-003). Not "PORT": that name is ambiguous once web and
# api share one .env in local dev.
API_PORT=4000

# apps/web -> apps/api proxy target (CR-011, next.config.ts's rewrites()).
# Server-only: the browser only ever calls same-origin /api/v1/... (ADR-013).
API_INTERNAL_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_ride

# apps/api's test suite reads THIS var, never DATABASE_URL above — CR-096/KI-049:
# a previous session sourced this file before running tests, and DATABASE_URL
# pointed at a real dev database with real data; the suite's unscoped
# `DELETE FROM rides`/`DELETE FROM users` cleanup wiped it. Point this at a
# database you never mind being emptied — e.g. the Docker Compose `postgres`
# service's own "coffee_ride" database (docker-compose.yml, NOT your native/
# Homebrew Postgres's dev database, if you keep one of those too). The test
# suite also refuses to run (apps/api/src/test-support/test-database-url.ts)
# against anything whose database name doesn't look disposable, as a second
# line of defense.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_ride
# Matches docker-compose.yml's dev-only `redis-dev-only` password (CR-077,
# KI-003). A production REDIS_URL points at a real, separately-provisioned
# instance — docker-compose.prod.yml never runs one itself (ADR-018), so
# that instance's own operator is responsible for its password/persistence.
REDIS_URL=redis://:redis-dev-only@localhost:6379

# Optional, test/dev only (KI-014): overrides the auth endpoints' 5-per-minute
# rate limit (per IP and per account) so repeated local e2e runs against an
# already-running dev API don't hit 429. apps/api refuses to start in
# production with this set at all — leave it unset outside local dev.
# AUTH_RATE_LIMIT_MAX=1000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=coffee-ride

# Generate with: openssl rand -base64 32
# The API refuses to start in production on this placeholder value (CR-073).
AUTH_SECRET=change-me

# The single browser origin allowed through the CSRF Origin/Referer check
# (ADR-013, CR-012, apps/api/src/plugins/csrf.ts). Same-origin deployment
# (ADR-013): this is the origin apps/web is served from.
WEB_ORIGIN=http://localhost:3000

# 2GIS uses separate keys per product. They are NOT interchangeable:
#
#   MapGL (browser map rendering) — this key ships inside the browser bundle by
#   design, so it must be restricted to your domains in the 2GIS console.
NEXT_PUBLIC_MAPS_2GIS_MAPGL_KEY=
#
#   Geocoder + Directions/Routing — billed per request and called ONLY from
#   apps/api (packages/maps-2gis). Never prefix this one with NEXT_PUBLIC_: that
#   would inline it into the browser bundle and let anyone burn the quota.
MAPS_2GIS_API_KEY=

# Unisender Go — transactional email (ADR-007, CR-100): the verify-email/
# password-reset links register/forgot-password issue. Optional: unset
# means apps/api falls back to the pre-CR-100 dev-only behavior (token only
# ever visible via the register response/direct API call, never a real
# email). Get a key from your Unisender Go account's API settings.
UNISENDER_API_KEY=
# Region-specific endpoint (go1 vs go2) — must match whichever data center
# your Unisender Go account was created on, shown in its dashboard.
UNISENDER_API_URL=https://go1.unisender.ru/ru/transactional/api/v1/
# Must be a sender address verified in your Unisender Go account — sending
# with an unverified address is rejected by Unisender, not by this app.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Coffee Ride"

# docker-compose.prod.yml only (CR-075, ADR-018) — meaningless in local dev.
# Caddy requests/renews a real Let's Encrypt certificate for DOMAIN
# automatically, so DOMAIN must be a real hostname with public DNS already
# pointed at the host, and ACME_EMAIL a real address (Let's Encrypt expiry
# notices). api's WEB_ORIGIN is derived from DOMAIN in that file, not set
# separately here.
DOMAIN=
ACME_EMAIL=

# Optional (CR-079/KI-006). No error-tracking vendor is decided yet — unset
# means apps/api only logs errors structurally (still fully "visible" per
# .claude/rules/resilience.md). If set, every unexpected 500 and every
# notification job failure is additionally POSTed as JSON to this URL
# (apps/api/src/plugins/error-reporting.ts) — a generic sink, not a specific
# vendor's SDK.
ERROR_REPORTING_WEBHOOK_URL=

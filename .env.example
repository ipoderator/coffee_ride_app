NODE_ENV=development

# apps/api listen port (CR-003). Not "PORT": that name is ambiguous once web and
# api share one .env in local dev.
API_PORT=4000

# apps/web -> apps/api proxy target (CR-011, next.config.ts's rewrites()).
# Server-only: the browser only ever calls same-origin /api/v1/... (ADR-013).
API_INTERNAL_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_ride
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=coffee-ride

# Generate with: openssl rand -base64 32
# The API refuses to start in production on this placeholder value (CR-073).
AUTH_SECRET=change-me

# 2GIS uses separate keys per product. They are NOT interchangeable:
#
#   MapGL (browser map rendering) — this key ships inside the browser bundle by
#   design, so it must be restricted to your domains in the 2GIS console.
NEXT_PUBLIC_MAPS_2GIS_MAPGL_KEY=
#
#   Geocoder + Directions/Routing — billed per request and called ONLY from
#   apps/api (packages/maps-2gis). Never prefix this one with NEXT_PUBLIC_: that
#   would inline it into the browser bundle and let anyone burn the quota.
MAPS_2GIS_API_KEY=

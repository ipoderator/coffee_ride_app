{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-preservation-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-preservation-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 8000,
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true
  }
}
